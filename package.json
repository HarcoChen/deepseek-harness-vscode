{
    "name": "dsh-vsc-integration",
    "displayName": "%extension.displayName%",
    "description": "%extension.description%",
    "version": "0.6.2",
    "publisher": "harcochen",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/HarcoChen/deepseek-harness-vscode.git"
    },
    "bugs": {
        "url": "https://github.com/HarcoChen/deepseek-harness-vscode/issues"
    },
    "homepage": "https://github.com/HarcoChen/deepseek-harness-vscode#readme",
    "icon": "resources/dsh.png",
    "galleryBanner": {
        "color": "#0F172A",
        "theme": "dark"
    },
    "l10n": "./l10n",
    "engines": {
        "vscode": "^1.106.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "virtualWorkspaces": false,
        "untrustedWorkspaces": {
            "supported": false,
            "description": "%extension.untrustedWorkspace%"
        }
    },
    "categories": [
        "Chat",
        "Machine Learning"
    ],
    "keywords": [
        "DeepSeek",
        "DeepSeek Harness",
        "dsh",
        "AI",
        "coding agent",
        "AI assistant",
        "code review",
        "diff",
        "debugging",
        "chat"
    ],
    "main": "./dist/extension.js",
    "types": "./dist/extension.d.ts",
    "chatParticipants": [
        {
            "id": "dsh",
            "name": "DSH",
            "description": "Send a task to the DeepSeek Harness session"
        }
    ],
    "activationEvents": [
        "onStartupFinished",
        "onView:dsh.chatView",
        "onCommand:dsh.open",
        "onCommand:dsh.openTrace",
        "onWebviewPanel:dsh.traceEditor",
        "onCommand:dsh.newSession",
        "onCommand:dsh.switchSession",
        "onCommand:dsh.searchSession",
        "onCommand:dsh.selectModel",
        "onCommand:dsh.renameSession",
        "onCommand:dsh.forkSession",
        "onCommand:dsh.archiveSession",
        "onCommand:dsh.start",
        "onCommand:dsh.stop",
        "onCommand:dsh.restart",
        "onCommand:dsh.insertEditorReference",
        "onCommand:dsh.askAboutResource",
        "onCommand:dsh.explainDebugState",
        "onCommand:dsh.editorTask.explain",
        "onCommand:dsh.editorTask.fix",
        "onCommand:dsh.editorTask.review",
        "onCommand:dsh.editorTask.docs",
        "onCommand:dsh.gitDiffTask.explain",
        "onCommand:dsh.gitDiffTask.fix",
        "onCommand:dsh.gitDiffTask.review",
        "onCommand:dsh.gitDiffTask.docs",
        "onCommand:dsh.openIdeContextPicker",
        "onCommand:dsh.captureAppShot",
        "onCommand:dsh.configureApiKey",
        "onCommand:dsh.manageProviders",
        "onCommand:dsh.manageWorkspaces",
        "onCommand:dsh.manageAgentPresets",
        "onCommand:dsh.refreshBalance",
        "onCommand:dsh.diagnoseEnvironment",
        "onCommand:dsh.openLogs",
        "onCommand:dsh.openInBrowser"
    ],
    "contributes": {
        "chatParticipants": [
            {
                "id": "dsh",
                "name": "dsh",
                "fullName": "DeepSeek Harness",
                "description": "%chatParticipant.description%",
                "isSticky": true
            }
        ],
        "viewsContainers": {
            "secondarySidebar": [
                {
                    "id": "dsh",
                    "title": "DSH",
                    "icon": "resources/dsh.svg"
                }
            ]
        },
        "views": {
            "dsh": [
                {
                    "type": "webview",
                    "id": "dsh.chatView",
                    "name": "%view.chat.name%",
                    "icon": "resources/dsh.svg",
                    "visibility": "visible"
                },
                {
                    "type": "tree",
                    "id": "dsh.conversationNavigation",
                    "name": "%view.conversationNavigation.name%",
                    "icon": "$(list-tree)",
                    "visibility": "collapsed"
                }
            ]
        },
        "commands": [
            {
                "command": "dsh.open",
                "title": "%command.open.title%",
                "category": "DSH",
                "icon": {
                    "light": "resources/dsh.svg",
                    "dark": "resources/dsh-dark.svg"
                }
            },
            {
                "command": "dsh.openTrace",
                "title": "%command.openTrace.title%",
                "category": "DSH",
                "icon": "$(pulse)"
            },
            {
                "command": "dsh.newSession",
                "title": "%command.newSession.title%",
                "category": "DSH",
                "icon": "$(add)"
            },
            {
                "command": "dsh.switchSession",
                "title": "%command.switchSession.title%",
                "category": "DSH",
                "icon": "$(list-selection)"
            },
            {
                "command": "dsh.searchSession",
                "title": "%command.searchSession.title%",
                "category": "DSH",
                "icon": "$(search)"
            },
            {
                "command": "dsh.selectModel",
                "title": "%command.selectModel.title%",
                "category": "DSH",
                "icon": "$(symbol-misc)"
            },
            {
                "command": "dsh.renameSession",
                "title": "%command.renameSession.title%",
                "category": "DSH",
                "icon": "$(edit)"
            },
            {
                "command": "dsh.forkSession",
                "title": "%command.forkSession.title%",
                "category": "DSH",
                "icon": "$(repo-forked)"
            },
            {
                "command": "dsh.archiveSession",
                "title": "%command.archiveSession.title%",
                "category": "DSH",
                "icon": "$(archive)"
            },
            {
                "command": "dsh.start",
                "title": "%command.start.title%",
                "category": "DSH",
                "icon": "$(play)"
            },
            {
                "command": "dsh.stop",
                "title": "%command.stop.title%",
                "category": "DSH",
                "icon": "$(debug-stop)"
            },
            {
                "command": "dsh.restart",
                "title": "%command.restart.title%",
                "category": "DSH",
                "icon": "$(refresh)"
            },
            {
                "command": "dsh.openLogs",
                "title": "%command.openLogs.title%",
                "category": "DSH",
                "icon": "$(output)"
            },
            {
                "command": "dsh.openInBrowser",
                "title": "%command.openInBrowser.title%",
                "category": "DSH",
                "icon": "$(link-external)"
            },
            {
                "command": "dsh.insertEditorReference",
                "title": "%command.insertEditorReference.title%",
                "category": "DSH",
                "icon": "$(references)"
            },
            {
                "command": "dsh.askAboutResource",
                "title": "%command.askAboutResource.title%",
                "category": "DSH",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "dsh.explainDebugState",
                "title": "%command.explainDebugState.title%",
                "category": "DSH",
                "icon": {
                    "light": "resources/dsh.svg",
                    "dark": "resources/dsh-dark.svg"
                }
            },
            {
                "command": "dsh.editorTask.explain",
                "title": "%dsh.editorTask.explain.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.editorTask.fix",
                "title": "%dsh.editorTask.fix.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.editorTask.review",
                "title": "%dsh.editorTask.review.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.editorTask.docs",
                "title": "%dsh.editorTask.docs.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.gitDiffTask.explain",
                "title": "%dsh.gitDiffTask.explain.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.gitDiffTask.fix",
                "title": "%dsh.gitDiffTask.fix.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.gitDiffTask.review",
                "title": "%dsh.gitDiffTask.review.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.gitDiffTask.docs",
                "title": "%dsh.gitDiffTask.docs.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.openIdeContextPicker",
                "title": "%command.openIdeContextPicker.title%",
                "category": "DSH",
                "icon": "$(settings)"
            },
            {
                "command": "dsh.insertPromptTemplate",
                "title": "%command.insertPromptTemplate.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.captureAppShot",
                "title": "%command.captureAppShot.title%",
                "category": "DSH",
                "icon": "$(device-camera)"
            },
            {
                "command": "dsh.configureApiKey",
                "title": "%command.configureApiKey.title%",
                "category": "DSH",
                "icon": "$(key)"
            },
            {
                "command": "dsh.manageProviders",
                "title": "%command.manageProviders.title%",
                "category": "DSH",
                "icon": "$(server-environment)"
            },
            {
                "command": "dsh.manageWorkspaces",
                "title": "%command.manageWorkspaces.title%",
                "category": "DSH",
                "icon": "$(folder-library)"
            },
            {
                "command": "dsh.manageAgentPresets",
                "title": "%command.manageAgentPresets.title%",
                "category": "DSH",
                "icon": "$(symbol-misc)"
            },
            {
                "command": "dsh.refreshBalance",
                "title": "%command.refreshBalance.title%",
                "category": "DSH",
                "icon": "$(dashboard)"
            },
            {
                "command": "dsh.diagnoseEnvironment",
                "title": "%command.diagnoseEnvironment.title%",
                "category": "DSH",
                "icon": "$(tools)"
            },
            {
                "command": "dsh.revealConversationMilestone",
                "title": "%command.revealConversationMilestone.title%",
                "category": "DSH"
            }
        ],
        "submenus": [
            {
                "id": "dsh.editorTasks",
                "label": "%dsh.editorTasks.label%"
            },
            {
                "id": "dsh.gitDiffTasks",
                "label": "%dsh.gitDiffTasks.label%"
            }
        ],
        "keybindings": [
            {
                "command": "dsh.open",
                "key": "ctrl+shift+alt+d",
                "mac": "cmd+shift+alt+d"
            },
            {
                "command": "dsh.insertEditorReference",
                "key": "alt+k",
                "mac": "alt+k",
                "when": "editorTextFocus"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "dsh.revealConversationMilestone",
                    "when": "false"
                }
            ],
            "editor/title": [
                {
                    "command": "dsh.open",
                    "group": "navigation@dsh"
                }
            ],
            "editor/context": [
                {
                    "submenu": "dsh.editorTasks",
                    "group": "navigation@dsh"
                }
            ],
            "explorer/context": [
                {
                    "command": "dsh.askAboutResource",
                    "group": "navigation@dsh"
                }
            ],
            "debug/toolBar": [
                {
                    "command": "dsh.explainDebugState",
                    "when": "debugState == 'stopped'",
                    "group": "navigation@dsh"
                }
            ],
            "dsh.editorTasks": [
                {
                    "command": "dsh.editorTask.explain",
                    "group": "1_tasks@1"
                },
                {
                    "command": "dsh.editorTask.fix",
                    "group": "1_tasks@2"
                },
                {
                    "command": "dsh.editorTask.review",
                    "group": "1_tasks@3"
                },
                {
                    "command": "dsh.editorTask.docs",
                    "group": "1_tasks@4"
                }
            ],
            "scm/resourceGroup/context": [
                {
                    "submenu": "dsh.gitDiffTasks",
                    "when": "scmProvider == git",
                    "group": "navigation@dsh"
                }
            ],
            "dsh.gitDiffTasks": [
                {
                    "command": "dsh.gitDiffTask.explain",
                    "group": "1_tasks@1"
                },
                {
                    "command": "dsh.gitDiffTask.fix",
                    "group": "1_tasks@2"
                },
                {
                    "command": "dsh.gitDiffTask.review",
                    "group": "1_tasks@3"
                },
                {
                    "command": "dsh.gitDiffTask.docs",
                    "group": "1_tasks@4"
                }
            ],
            "view/title": [
                {
                    "command": "dsh.newSession",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh0"
                },
                {
                    "command": "dsh.switchSession",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh0.1"
                },
                {
                    "command": "dsh.openInBrowser",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh1"
                },
                {
                    "command": "dsh.openTrace",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh0.2"
                },
                {
                    "command": "dsh.openLogs",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh2"
                },
                {
                    "command": "dsh.restart",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh3"
                }
            ]
        },
        "configuration": {
            "title": "DSH IDE",
            "properties": {
                "dsh.command": {
                    "type": "string",
                    "default": "pnpm",
                    "description": "%config.command.description%"
                },
                "dsh.commandArgs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "dlx",
                        "@deepseek-ai/dsh",
                        "web",
                        "--no-open"
                    ],
                    "description": "%config.commandArgs.description%"
                },
                "dsh.npxTimeoutMs": {
                    "type": "number",
                    "default": 120000,
                    "minimum": 10000,
                    "maximum": 600000,
                    "description": "%config.npxTimeoutMs.description%"
                },
                "dsh.npmRegistry": {
                    "type": "string",
                    "default": "https://registry.npmmirror.com",
                    "description": "%config.npmRegistry.description%"
                },
                "dsh.enableCompaction": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableCompaction.description%"
                },
                "dsh.serverUrl": {
                    "type": "string",
                    "default": "",
                    "description": "%config.serverUrl.description%"
                },
                "dsh.serverPort": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 65535,
                    "description": "%config.serverPort.description%"
                },
                "dsh.autoStart": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.autoStart.description%"
                },
                "dsh.installWhenMissing": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.installWhenMissing.description%"
                },
                "dsh.runtimeVersion": {
                    "type": "string",
                    "default": "0.1.2-rc.1",
                    "pattern": "^[0-9A-Za-z.-]+$",
                    "description": "%config.runtimeVersion.description%"
                },
                "dsh.startupTimeoutMs": {
                    "type": "number",
                    "default": 30000,
                    "minimum": 1000,
                    "maximum": 120000,
                    "description": "%config.startupTimeoutMs.description%"
                },
                "dsh.requestTimeoutMs": {
                    "type": "number",
                    "default": 600000,
                    "minimum": 10000,
                    "maximum": 3600000,
                    "description": "%config.requestTimeoutMs.description%"
                },
                "dsh.maxContextBytes": {
                    "type": "number",
                    "default": 120000,
                    "minimum": 1000,
                    "maximum": 1000000,
                    "description": "%config.maxContextBytes.description%"
                },
                "dsh.terminalHistorySize": {
                    "type": "number",
                    "default": 20,
                    "minimum": 1,
                    "maximum": 100,
                    "description": "%config.terminalHistorySize.description%"
                },
                "dsh.persistSession": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.persistSession.description%"
                },
                "dsh.apiKeyEnv": {
                    "type": "string",
                    "default": "DEEPSEEK_API_KEY",
                    "description": "%config.apiKeyEnv.description%"
                },
                "dsh.agentStatusLabel": {
                    "type": "string",
                    "default": "",
                    "maxLength": 256,
                    "description": "%config.agentStatusLabel.description%"
                },
                "dsh.agentStatusLabels": {
                    "type": "array",
                    "default": [
                        "大肥鱼正在深潜…",
                        "大肥鱼摆摆尾巴，想想办法…",
                        "大肥鱼翻了个身，继续思考…",
                        "大肥鱼正在吞吐上下文…",
                        "大肥鱼在鱼缸里转圈…",
                        "大肥鱼：这题我会…"
                    ],
                    "items": {
                        "type": "string",
                        "maxLength": 256
                    },
                    "description": "%config.agentStatusLabels.description%"
                },
                "dsh.balanceRefreshIntervalMs": {
                    "type": "number",
                    "default": 30000,
                    "minimum": 10000,
                    "maximum": 3600000,
                    "description": "%config.balanceRefreshIntervalMs.description%"
                },
                "dsh.enableEffortKnob": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableEffortKnob.description%"
                }
            }
        }
    },
    "scripts": {
        "build:webview": "node ./scripts/build-webview.mjs",
        "sync:locales": "node ./scripts/sync-locales.mjs",
        "compile": "npm run sync:locales && npm run build:webview && tsc -p ./tsconfig.json",
        "watch": "tsc -watch -p ./tsconfig.json",
        "check": "tsc --noEmit -p ./tsconfig.json && tsc --noEmit -p ./webview/tsconfig.json",
        "check:host": "tsc --noEmit -p ./tsconfig.json",
        "check:webview": "tsc --noEmit -p ./webview/tsconfig.json",
        "test": "npm run check:webview && npm run compile && node --test test/*.test.js",
        "package": "npm run compile && vsce package",
        "release": "node ./scripts/release.mjs"
    },
    "dependencies": {
        "ws": "8.21.0"
    },
    "devDependencies": {
        "@types/react": "^18.3.24",
        "@types/react-dom": "^18.3.7",
        "@types/node": "^22.10.2",
        "@types/vscode": "^1.106.0",
        "@types/ws": "8.18.1",
        "@vscode/vsce": "^3.6.0",
        "esbuild": "^0.25.9",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "typescript": "^5.7.2"
    }
}
